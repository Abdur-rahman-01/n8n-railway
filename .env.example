# Webhook URL - Railway will provide the actual domain
WEBHOOK_TUNNEL_URL=https://your-app-name.up.railway.app/

# Basic Auth for Editor UI
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=supersecurepassword

# Encryption key for credentials
N8N_ENCRYPTION_KEY=change_this_to_a_random_32_char_string

# PostgreSQL (Railway will provide env variables)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${PGHOST}
DB_POSTGRESDB_PORT=${PGPORT}
DB_POSTGRESDB_DATABASE=${PGDATABASE}
DB_POSTGRESDB_USER=${PGUSER}
DB_POSTGRESDB_PASSWORD=${PGPASSWORD}

# Executions data save settings
EXECUTIONS_PROCESS=main
